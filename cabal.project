packages: . olm/

-- libolm (the reference Olm/Megolm C library) is installed under ~/.local (built from source; it
-- was dropped from Homebrew when upstream moved to the pure-Rust vodozemac). The `olm` package's
-- FFI links against it. Machine-specific paths — adjust for another host, or install libolm to a
-- standard prefix.
package olm
  extra-lib-dirs: /Users/ijaehyeon/.local/lib
  extra-include-dirs: /Users/ijaehyeon/.local/include
