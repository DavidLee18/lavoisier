{-  Example Dhall config for `lav`.

    Copy to `lavoisier.dhall` (auto-loaded from the working dir) or pass `--config <PATH>`.
    Every field is optional — `Config::{ … }` fills the rest with `None`, so write only what you
    want to set. An explicit CLI flag always wins over the file.

    Everything enumerable is a union, so `provider = Some L.Provider.Anthropi` is a type error at
    load listing the valid alternatives, rather than a runtime failure inside the provider factory.
-}
let L = ./schema.dhall

in  L.Config::{
    , provider = Some L.Provider.Anthropic
    , model = Some "claude-sonnet-4-5"
    , thinking = Some L.Thinking.Medium
    , maxSteps = Some 12

    -- Cost controls. `budget` is the whole-task cost-weighted token ceiling.
    , budget = Some 400000
    , cheapModel = Some "claude-haiku-4-5"
    , escalateAfter = Some 2

    -- Accuracy levers are opt-in; the default posture is efficiency-first.
    , requireEdit = Some True
    , verifyCmd = Some "cabal build && cabal test"
    , verifyAndFix = Some True

    -- Gateways. Ports are Naturals; the decoder rejects 0 and >65535 by name.
    , serve = Some 8080
    , serveA2a = Some 8081
    , logLevel = Some L.LogLevel.Info

    -- Provider-run tools. The sets are disjoint across providers, so a tool the chosen provider
    -- cannot run is refused by name before the request is sent, never dropped. `--server-tools`
    -- takes the same names with defaults; this list is where the filters go.
    , serverTools = Some
      [ L.webSearch
      , L.ServerTool.WebSearch
        { maxUses = Some 5
        , allowedDomains = [ "docs.haskell.org" ]
        , blockedDomains = [] : List Text
        }
      , L.ServerTool.CodeExecution
      ]

    -- MCP servers: the stdio-vs-HTTP choice is stated, not sniffed from the string.
    , mcpServers = Some
      [ L.Mcp::{
        , label = "fs"
        , target = L.McpTarget.Stdio "npx -y @modelcontextprotocol/server-filesystem ."
        }
      , L.Mcp::{ label = "docs", target = L.McpTarget.Http "https://mcp.example.org/sse" }
      ]

    -- The council pre-pass: >=2 debaters draft -> critique -> judge a plan.
    , legionDebaters = Some
      [ L.ModelRef::{ provider = L.Provider.Anthropic, model = "claude-sonnet-4-5" }
      , L.ModelRef::{ provider = L.Provider.Google, model = "gemini-2.5-flash" }
      ]
    , legionJudge = Some L.ModelRef::{
      , provider = L.Provider.Anthropic
      , model = "claude-sonnet-4-5"
      }
    , legionRounds = Some 1
    , lang = Some L.Language.Korean

    -- Fallback chain: rerouted to when the primary errors before streaming any output.
    , fallback = Some
      [ L.ModelRef::{ provider = L.Provider.Google, model = "gemini-2.5-flash" } ]
    , fallbackCooldown = Some 60

    -- Cron: the schedule fields are named, and the prompt is its own field.
    , cron = Some
      [ L.CronJob::{
        , schedule = L.Schedule::{ minute = "*/30", hour = "9-17", dayOfWeek = "1-5" }
        , prompt = "check CI and report failures"
        }
      , L.CronJob::{ schedule = L.dailyAt 9, prompt = "summarise yesterday's commits" }
      ]

    -- Matrix per-room / per-member tool permissions. Absent = unconstrained; when both apply the
    -- effective set is their INTERSECTION.
    , serveMatrix = Some True
    , matrixRoomTools = Some
      [ { subject = "!ops:hs", tools = [ "shell", "read_file" ] }
      , { subject = "!general:hs", tools = [ "read_file" ] }
      ]
    , matrixUserTools = Some
      [ { subject = "@bob:hs", tools = [ "read_file", "read_files" ] } ]
    }
