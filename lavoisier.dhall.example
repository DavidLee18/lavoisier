-- Example Dhall config for `lav` (the Haskell port uses Dhall, not TOML).
--
-- Copy to `lavoisier.dhall` (auto-loaded from the working dir) or pass `--config <PATH>`.
-- Every field is optional: this record is merged over an all-`None` defaults record, so you only
-- need to write the fields you want to set. An explicit CLI flag always wins over the file.
-- Dhall type-checks the file at load, so a typo or wrong type is a clear error.

{ provider = Some "anthropic" -- "anthropic" | "google"
, model = None Text -- e.g. Some "claude-sonnet-4-5" / Some "gemini-2.5-flash"
, thinking = None Text -- "off" | "low" | "medium" | "high"
, maxTokens = None Natural -- generated-token ceiling
, maxSteps = Some 12 -- agent tool-loop step budget
, contextLimit = None Natural -- per-request token ceiling; evict oldest tool output when exceeded
, cheapModel = None Text -- cheaper model for the first escalateAfter round-trips
, escalateAfter = None Natural -- round-trips on cheapModel before escalating (default 2)
, advisorModel = None Text -- smarter model for a one-shot planning pre-pass
, budget = None Natural -- whole-task cost-weighted token budget; stop when exceeded
, noProgressLimit = None Natural -- hard-stop after 2N edit-free round-trips (nudge at N)
, serve = None Natural -- HTTP gateway port (POST /v1/turns, GET /health)
, serveA2a = None Natural -- A2A gateway port
, serveAcp = None Natural -- ACP gateway port
, serveSlack = None Bool -- Some True serves over Slack Socket Mode (needs SLACK_APP_TOKEN + SLACK_BOT_TOKEN)
, serveMatrix = None Bool -- Some True serves over Matrix (needs MATRIX_HOMESERVER + MATRIX_USER + token/password)
, sessionDir = None Text -- durable session store dir (else in-memory)
, mcpServers = -- external MCP servers whose tools are exposed to the agent (--agent / --serve*)
    Some [ "fs: npx -y @modelcontextprotocol/server-filesystem ." ]
    -- each entry is "label: target"; target is a stdio command or an http(s):// URL.
    -- tools are namespaced <label>_<tool>. None (List Text) to set none.
, tune = None Bool -- Some True enables the ATO learner (ε-greedy knob tuning)
, tuneBayes = None Bool -- Some True uses the Bayesian (Thompson) learner instead of ε-greedy
, tuneState = None Text -- Some "path" to load/persist learned ATO profiles as JSON
, legionDebaters = -- the council pre-pass: ≥2 "provider:model" debaters draft→critique→judge a plan
    None (List Text) -- e.g. Some [ "anthropic:claude-sonnet-4-5", "google:gemini-2.5-flash" ]
, legionJudge = None Text -- Some "provider:model" for the judge (default: the first debater)
, legionRounds = None Natural -- critique rounds after the draft (default 1; 0 = draft then judge)
, lang = None Text -- locale for council progress notices (only ko_KR selects Korean)
, cron = -- cron jobs: 5 schedule fields then a prompt (fires TurnRequests on a UTC schedule)
    None (List Text) -- e.g. Some [ "*/30 9-17 * * 1-5 check CI and report failures" ]
, cronFile = None Text -- Some "path" to a JSON file of {schedule,session?,prompt,retry_max?,retry_wait?}
, cronRetryMax = None Natural -- global default retries after a failed cron fire (default 0)
, cronRetryWait = None Natural -- global default seconds between cron retries (default 0)
}
