cabal-version:      3.0
name:               lavoisier
version:            0.13.0
synopsis:           Token-efficient CLI coding agent — a Haskell port of the Rust `lavoisier`.
description:
  A modular, token-efficient CLI coding agent with a provider-agnostic core.
  This is the Haskell port (see reference-rust/ for the original Rust workspace).
license:            MIT
license-file:       LICENSE
author:             Jaehyun Lee
maintainer:         djwodus@gmail.com
homepage:           https://github.com/DavidLee18/lavoisier
category:           Development
build-type:         Simple

common lang
  default-language:   GHC2021
  default-extensions:
    OverloadedStrings
    LambdaCase
    RecordWildCards
    DerivingStrategies
    StrictData
    ImportQualifiedPost
    DeriveGeneric
  ghc-options:
    -Wall -Werror
    -Wincomplete-patterns -Wincomplete-uni-patterns
    -Wincomplete-record-updates

library
  import:           lang
  hs-source-dirs:   src
  exposed-modules:
    Lavoisier.Agent
    Lavoisier.CLI
    Lavoisier.Config
    Lavoisier.Gateway.A2A
    Lavoisier.Gateway.Acp
    Lavoisier.Gateway.Http
    Lavoisier.Memory
    Lavoisier.Protocol
    Lavoisier.Protocol.Agent
    Lavoisier.Protocol.Event
    Lavoisier.Protocol.Gateway
    Lavoisier.Protocol.Message
    Lavoisier.Protocol.Provider
    Lavoisier.Protocol.Stream
    Lavoisier.Protocol.Tool
    Lavoisier.Provider.Anthropic
    Lavoisier.Provider.Anthropic.Sse
    Lavoisier.Provider.Google
    Lavoisier.Provider.Google.Sse
    Lavoisier.Tool.Builtins
    Lavoisier.Tool.Registry
  build-depends:
    , base                  >=4.19 && <5
    , aeson                 >=2.1
    , bytestring
    , containers
    , dhall
    , directory
    , filepath
    , http-client
    , http-client-tls
    , http-types
    , optparse-applicative
    , scientific
    , text
    , typed-process
    , unordered-containers
    , vector
    , wai
    , warp

executable lav
  import:           lang
  hs-source-dirs:   app
  main-is:          Main.hs
  -- warp needs the threaded runtime (its timer manager); -N uses all cores.
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    , base
    , lavoisier
    , text

test-suite lavoisier-test
  import:           lang
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  build-depends:
    , base
    , aeson
    , bytestring
    , directory
    , filepath
    , http-types
    , lavoisier
    , QuickCheck
    , tasty
    , tasty-hunit
    , tasty-quickcheck
    , text
    , wai
    , wai-extra
