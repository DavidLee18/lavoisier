# Presentation only — nothing here moves, is excluded from the build, or changes what ships.
# These markers tell GitHub's linguist which trees are not hand-written, so language statistics,
# diffs, and blame reflect the code someone actually maintains.
#
# NOTE: this tree vendors no C. The tree-sitter grammars come from crates.io as ordinary
# dependencies, so the "89.8% C" distortion that afflicts a tree vendoring `parser.c` does not
# apply — the scope below is deliberately small rather than copied wholesale.

# Generated by prost/tonic from the vendored xAI protos, and COMMITTED on purpose: downstream
# `cargo install` and docs.rs builds must not need `protoc`. Regenerate with
# `LVZ_XAI_REGEN=1 cargo build -p lvz-xai` — never hand-edit.
crates/lvz-xai/src/generated/** linguist-generated=true

# Vendored verbatim from xai-org/xai-proto (see crates/lvz-xai/proto/VENDOR.md). Ours to build
# against, not ours to author.
crates/lvz-xai/proto/** linguist-vendored=true

# Benchmark task definitions and fixtures: inputs to a measurement, not library code.
bench/tasks/** linguist-vendored=true
