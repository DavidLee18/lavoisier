# Linguist classification. These paths stay committed on purpose — see CLAUDE.md — but they are not
# code anyone writes or reviews here, and left unmarked they dominate every measure of the repo:
# GitHub reported Lavoisier as a C project (716k lines of vendored parsers against 19k of
# first-party Haskell), and PR diffs that touch them are unreadable.
#
# Marking them changes presentation only. Nothing moves, nothing is regenerated at build time, and
# `cabal install` from a git tag keeps working — which it would not if these were gitignored, since
# a git-dependency consumer (lvz-extra-tools pins this repo that way) has no chance to run codegen,
# and `gen/` cannot be rebuilt from anything in-tree anyway: there are no .proto files here.

# xAI protobuf bindings, generated by proto-lens from github.com/xai-org/xai-proto.
gen/** linguist-generated=true

# tree-sitter parsers, scanners, and grammar tables, vendored verbatim from the upstream grammar
# repos and pinned to grammar ABI 15.
cbits/ts-*/** linguist-vendored=true

# Synthetic repo snapshots for the budget/skeleton tests. First-party, but fixtures rather than
# source: without this the five .rs files make GitHub list Rust as a project language, which after
# the Haskell swap is exactly the wrong signal.
tests/budget/** linguist-detectable=false
